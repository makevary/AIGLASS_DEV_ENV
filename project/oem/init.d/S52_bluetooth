#!/bin/sh

export RK96X_TARGET_PATH=/userdata/rx96x
export DBUS_SYSTEM_BUS_ADDRESS='unix:path=/var/run/dbus/system_bus_socket'
export LD_LIBRARY_PATH=/oem/usr/lib:$LD_LIBRARY_PATH
DBUS_COMPAT_ROOT=/run/dbus-compat
DBUS_PID=/run/messagebus.pid
DBUS_SOCKET=/run/dbus/system_bus_socket

process_running()
{
    ps | grep "$1" | grep -v grep >/dev/null 2>&1
}

HCICONFIG=hciconfig
if [ -x /oem/usr/bin/hciconfig ]; then
    HCICONFIG=/oem/usr/bin/hciconfig
fi

# Create dbus directory
mkdir -p /run/dbus/
mkdir -p /var/run/dbus/
mkdir -p "$DBUS_COMPAT_ROOT/share/dbus-1" "$DBUS_COMPAT_ROOT/var/run/dbus"
ln -snf /usr/share/dbus-1/system.conf "$DBUS_COMPAT_ROOT/share/dbus-1/system.conf"
ln -snf /run/dbus/system_bus_socket "$DBUS_COMPAT_ROOT/var/run/dbus/system_bus_socket"

# Start dbus
echo "Starting dbus-daemon..."
if process_running dbus-daemon; then
    echo "dbus-daemon already running"
else
    rm -f "$DBUS_PID" "$DBUS_SOCKET"
    /oem/usr/bin/dbus-daemon --fork --config-file=/usr/share/dbus-1/system.conf
fi

# Initialize Bluetooth hardware (rk_hciattach)
echo "Initializing Bluetooth hardware..."
/oem/usr/bin/rk_hciattach -n -s 115200 -m 1 /dev/ttyS2 rockchip 3000000 noflow nosleep &
# Wait for hci0 to be registered by rk_hciattach. Use sysfs here instead of
# polling hciconfig, because hciconfig issues HCI commands while the UART may
# still be settling.
HCI_READY=0
HCI_WAIT=0
while [ "$HCI_WAIT" -lt 24 ]; do
    if [ -e /sys/class/bluetooth/hci0 ]; then
        HCI_READY=1
        break
    fi
    sleep 0.5
    HCI_WAIT=$((HCI_WAIT + 1))
done

# Bring up hci0.
echo "Bringing up hci0..."
if [ "$HCI_READY" = "1" ]; then
    sleep 6
    if ! "$HCICONFIG" hci0 up; then
        echo "failed to bring up hci0"
        exit 1
    fi
else
    echo "hci0 not found after waiting for rk_hciattach"
    exit 1
fi

# Start BT Service. bt_service owns bluetoothd/BlueALSA startup through
# vendor and audio-server callbacks; starting them here creates duplicate
# Profile/Media registrations and races with the service-managed instance.
sleep 2
echo "Starting BT Service..."
/oem/usr/bin/bt_service BT &
